<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <rect width="100" height="100" rx="20" fill="#24282e" />
  <!-- Hair / Face Background -->
  <circle cx="50" cy="42" r="22" fill="#d4d4d8" />
  <path d="M 32 36 Q 50 18 68 36 Q 50 28 32 36 Z" fill="#18181b" />
  <!-- Glasses -->
  <rect x="34" y="38" width="13" height="10" rx="3" fill="#18181b" />
  <rect x="53" y="38" width="13" height="10" rx="3" fill="#18181b" />
  <line x1="47" y1="42" x2="53" y2="42" stroke="#18181b" stroke-width="2" />
  <!-- Glasses lenses reflections -->
  <line x1="36" y1="40" x2="43" y2="46" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
  <line x1="55" y1="40" x2="62" y2="46" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
  <!-- Smile -->
  <path d="M 45 53 Q 50 56 55 53" fill="none" stroke="#18181b" stroke-width="1.5" stroke-linecap="round" />
  <!-- Suit / Body -->
  <path d="M 22 90 C 22 68 36 64 50 64 C 64 64 78 68 78 90 Z" fill="#18181b" />
  <!-- Shirt & Tie -->
  <polygon points="50,64 43,76 57,76" fill="#f4f4f5" />
  <polygon points="48,74 52,74 53,88 50,91 47,88" fill="#52525b" />
</svg>
